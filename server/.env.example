
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>/<database>"
DB_NAME="healthph_dev"
CLIENT_URL="http://localhost:5173"
# Invitation emails link to CLIENT_URL. Use a reachable dashboard URL for recipients.
ACCOUNT_INVITATION_EXPIRE_HOURS=24
HEALTHPH_SUPPORT_EMAIL=""
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Web dashboard session: 8 hours from sign-in.
ACCESS_TOKEN_EXPIRE_MINUTES=480
MOBILE_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"
SECRET_KEY="<generate-a-long-random-signing-secret>"
FORGOT_PWD_SECRET_KEY="<generate-a-different-random-secret>"

SMTP_SERVER="<smtp-host>"
SMTP_PORT=587
SMTP_USERNAME="<smtp-username>"
SMTP_PASSWORD="<smtp-password>"
SMTP_SENDER_EMAIL="<sender@example.com>"

TIMEDELTA_DAYS=999

# Shared FastAPI entry point
HOST="0.0.0.0"
PORT=8000
HEALTHPH_RELOAD=true
HEALTHPH_WEB_BUILD_DIR="build"

# ports for models
HEALTHPH_LANGUAGE_URL="http://127.0.0.1:8001"
HEALTHPH_LANGUAGE_TIMEOUT_SECONDS=30
HEALTHPH_DISEASE_URL="http://127.0.0.1:8002"
HEALTHPH_DISEASE_TIMEOUT_SECONDS=30
#expired work becomes retryable
HEALTHPH_PROCESSING_LEASE_SECONDS=600
# grace period for interrupted works
HEALTHPH_LEGACY_PROCESSING_TIMEOUT_SECONDS=1800
HEALTHPH_SENTIMENT_URL="http://127.0.0.1:8003"
HEALTHPH_SENTIMENT_TIMEOUT_SECONDS=30
