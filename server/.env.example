# Copy to server/.env and fill real values on the backend host only.
# Never distribute server/.env, database credentials, or signing keys to Flutter.
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>/<database>"
DB_NAME="healthph_dev"
CLIENT_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

ACCESS_TOKEN_EXPIRE_MINUTES=60
MOBILE_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"
SECRET_KEY="<generate-a-long-random-signing-secret>"
FORGOT_PWD_SECRET_KEY="<generate-a-different-random-secret>"

SMTP_SERVER="<smtp-host>"
SMTP_PORT=587
SMTP_USERNAME="<smtp-username>"
SMTP_PASSWORD="<smtp-password>"
SMTP_SENDER_EMAIL="<sender@example.com>"

TIMEDELTA_DAYS=999

# Shared FastAPI entry point. Keep reload enabled locally; disable on a host.
HOST="0.0.0.0"
PORT=8000
HEALTHPH_RELOAD=true
# Relative to repository root, or an absolute directory. Build is optional.
HEALTHPH_WEB_BUILD_DIR="build"

# Internal service addresses, reachable from the BACKEND host, not Flutter.
HEALTHPH_LANGUAGE_URL="http://127.0.0.1:8001"
HEALTHPH_LANGUAGE_TIMEOUT_SECONDS=30
HEALTHPH_DISEASE_URL="http://127.0.0.1:8002"
HEALTHPH_DISEASE_TIMEOUT_SECONDS=30
