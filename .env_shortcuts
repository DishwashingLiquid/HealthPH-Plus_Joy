# Windows PowerShell shortcuts. Load from the repository root with:
# . ([scriptblock]::Create((Get-Content -LiteralPath .\.env_shortcuts -Raw)))
# Run each shortcut in a separate terminal; press Ctrl+C to stop it.

$HealthPHRoot = Split-Path -Parent (Resolve-Path -LiteralPath .\.env_shortcuts -ErrorAction Stop).Path

function run-lang {
    Push-Location -LiteralPath "$HealthPHRoot\services\language-detection-service" -ErrorAction Stop
    try {
        & .\.venv\Scripts\python.exe -m healthph_language.api --port 8001
    }
    finally {
        Pop-Location
    }
}

function run-disease {
    Push-Location -LiteralPath "$HealthPHRoot\services\disease-detection-service" -ErrorAction Stop
    try {
        & .\.venv\Scripts\python.exe -m healthph_plus.disease_api --port 8002
    }
    finally {
        Pop-Location
    }
}

function run-sentiment {
    Push-Location -LiteralPath "$HealthPHRoot\services\sentiment-analysis-service" -ErrorAction Stop
    try {
        & .\.venv\Scripts\python.exe -m healthph_sentiment.api --port 8003
    }
    finally {
        Pop-Location
    }
}

function run-back {
    Push-Location -LiteralPath "$HealthPHRoot\server" -ErrorAction Stop
    try {
        $env:HEALTHPH_LANGUAGE_URL = "http://127.0.0.1:8001"
        $env:HEALTHPH_DISEASE_URL = "http://127.0.0.1:8002"
        $env:HEALTHPH_SENTIMENT_URL = "http://127.0.0.1:8003"

        & .\.venv\Scripts\python.exe main.py
    }
    finally {
        Pop-Location
    }
}

function run-front {
    Push-Location -LiteralPath "$HealthPHRoot\client" -ErrorAction Stop
    try {
        npm run dev
    }
    finally {
        Pop-Location
    }
}
